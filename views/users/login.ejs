<% layout('/layouts/boilerplate') %>
    
<div class="row">  <!--for all row -->
    <h1 class="col-6 offset-3">Login</h1>
    <div class="col-6 offset-3" >
        <form action="/login" method="post" class="needs-validation" novalidate> 
            <div class="mg-3">
            <label for="username" class="form-label">Usename</label>
            <input type="text" name="username" id="username" class="form-control" required>  <!--herre listing is the object and title is the key it has been done due to it require to type all name in the create route  -->
            <div class="valid-feedback">Looks Good</div>
            <div class="invalid-feedback">Please enter the Username</div>
            </div>

            <div class="mg-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" name="password" id="password" class="form-control" required>  <!--herre listing is the object and title is the key it has been done due to it require to type all name in the create route  -->
            <div class="valid-feedback">Looks Good</div>
            <div class="invalid-feedback">Please enter the password</div>
        </div>
        <br><br>
        <button class="btn btn-success">Login</button>
        </form>
    </div>
</div>

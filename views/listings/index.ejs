<% layout("/layouts/boilerplate") %>


<!-- AIRBNB STYLE — CLEAN, NO SHADOW OR BOX -->
<div class="container-fluid px-3 pt-3">
  <div  class="d-flex flex-row gap-4 align-items-center "> <!-- this d-flex is used to keep this icons allign-->
    <div id="filters">
    <a href="/listings/category/Trending" 
